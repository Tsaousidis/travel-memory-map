# Copy to .env.local in the project root. Never commit .env.local.
# Leave Supabase values empty until Step 5 creates/connects the project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public MapLibre demo style for development; no API key required.
# A detailed city/place basemap will be selected during map integration.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
